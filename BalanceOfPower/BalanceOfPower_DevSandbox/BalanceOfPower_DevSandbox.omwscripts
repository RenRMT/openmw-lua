# Balance of Power -- debug overlay.
#
# Registers no content of its own. It reads whatever content pack is
# loaded and gives you hotkeys to drive it, so it sits on top of the
# Morrowind pack -- or any other -- rather than competing with it.
#
# Load AFTER BalanceOfPower_Framework and after any content pack.
#
# Safe to leave enabled while testing, but it writes power changes and
# forced days into your save, so it doesn't belong in a playthrough you
# care about.

# Answers debug commands by reading the framework's public interface.
GLOBAL: scripts/BoPDevSandbox/global.lua

# Hotkeys, on-screen output, and the cell watcher.
PLAYER: scripts/BoPDevSandbox/player.lua
