{
  // luacheck's 61x warnings (trailing whitespace, including inside comments)
  // are enabled by default, and `luacheck .` exits non-zero on any warning --
  // so a stray trailing space is a red CI run. Strip it on save instead.
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // luacheck's default max line length, which CI enforces.
  "editor.rulers": [120],

  "[lua]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
